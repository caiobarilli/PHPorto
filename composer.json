{
    "name": "phporto/phporto",
    "description": "Esqueleto PHP com provider de banco plugável (SQLite, MySQL, MongoDB).",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-pdo_mysql": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "suggest": {
        "mongodb/mongodb": "Necessário apenas para DB_PROVIDER=mongo. Requer também a extensão nativa ext-mongodb. Não é preciso para DB_PROVIDER=mysql."
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "pest",
        "stan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "require-dev": {
        "pestphp/pest": "^3",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    }
}
