<?php

declare(strict_types=1);

use App\Cli\Console;
use App\Cli\Main;
use App\Cli\Status;

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

$autoload = __DIR__ . DIRECTORY_SEPARATOR . 'vendor' . DIRECTORY_SEPARATOR . 'autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "Dependências ausentes. Rode composer install na raiz do projeto.\n");
    exit(78);
}

require $autoload;

$argv = $_SERVER['argv'] ?? [];
$args = is_array($argv) ? array_values(array_filter($argv, 'is_string')) : [];

exit((new Main(__DIR__, Console::standard()))->run(array_slice($args, 1)));
