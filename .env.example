# PHPorto — copie para .env e ajuste. Uma variável por linha, CHAVE=valor.
# Linha com # é comentário.

# ===========================================================================
# ACESSO
# ===========================================================================

# Token de acesso (campo de senha do HTTP Basic). Gere com: php token.php
# Vazio ou ausente: a aplicação responde 503 a tudo.
PHPORTO_AUTH_TOKEN=

# ===========================================================================
# WSL
# ===========================================================================

# Diretório inicial de toda execução, visto de dentro do WSL.
# Vazio ou ausente: nada é executado.
PHPORTO_WSL_ROOT=/home/usuario/projetos

# Distro passada ao wsl.exe -d; precisa aparecer em "wsl -l -q". Padrão: Debian.
PHPORTO_DISTRO=Debian

# Segundos até um comando do WSL ser morto. Padrão: 120. Piso: 30.
PHPORTO_TIMEOUT=120

# Fuso das datas na tela, identificador IANA. Padrão e fallback: America/Sao_Paulo.
PHPORTO_TZ=America/Sao_Paulo

# ===========================================================================
# WINDOWS
# ===========================================================================

# Segundos até uma ação do Windows ser cancelada. Padrão: 600. Piso: 60.
PHPORTO_WINUTIL_TIMEOUT=600

# ===========================================================================
# SUPERFÍCIES — true/false (também 1/0, yes/no, on/off)
# ===========================================================================

# As telas /, /config e /wsl. Padrão: true. Desligada, respondem 404.
PHPORTO_DASHBOARD_ENABLED=true

# A API JSON em /api/executions. Padrão: false. Desligada, responde 404.
# A /config pode alternar esta chave; o que ela grava vence o .env.
PHPORTO_API_ENABLED=false

# Origem aceita pela API. Padrão: http://127.0.0.1:4001.
CORS_ORIGIN=http://127.0.0.1:4001

# ===========================================================================
# BANCO
# ===========================================================================

# sqlite, mysql ou mongo. Padrão: sqlite. Outro valor: erro ao abrir o banco.
DB_PROVIDER=sqlite

# SQLite. Caminho relativo à raiz do projeto, ou absoluto. A pasta tem de
# existir; o arquivo nasce sozinho. Padrão: storage/database.sqlite.
SQLITE_PATH=storage/database.sqlite
SQLITE_TABLE=executions

# MongoDB. Só com DB_PROVIDER=mongo. Coleção padrão: executions.
MONGODB_URI="mongodb+srv://USUARIO:SENHA@CLUSTER.exemplo.mongodb.net/NOME_DO_BANCO?appName=APP_NAME"
MONGO_DB_NAME=nome_do_banco
MONGO_COLLECTION=executions

# MySQL. Só com DB_PROVIDER=mysql. Padrões: localhost, 3306, tabela executions.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nome_do_banco
MYSQL_USER=usuario
MYSQL_PASSWORD=senha
MYSQL_TABLE=executions

# ===========================================================================
# MYSQL DE TESTE (opcional)
# ===========================================================================

# Lidas do AMBIENTE pelos testes de integração do MySQL; a suíte não lê este
# arquivo. Sem MYSQL_TEST_DATABASE e MYSQL_TEST_USER, esses testes são pulados.
MYSQL_TEST_HOST=127.0.0.1
MYSQL_TEST_PORT=3306
MYSQL_TEST_DATABASE=nome_do_banco_de_teste
MYSQL_TEST_USER=usuario_de_teste
MYSQL_TEST_PASSWORD=senha_de_teste
