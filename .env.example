# PHPorto — copie este arquivo para .env e ajuste os valores.
# Uma variável por linha, CHAVE=valor, sem aspas. Linha com # é comentário.

# ===========================================================================
# WSL
# ===========================================================================

# Diretório inicial de TODA execução, visto de dentro do WSL.
# OBRIGATÓRIO: sem ele nada roda. Não há padrão de propósito — um padrão faria
# o comando cair no home do usuário do WSL em silêncio, e comando relativo
# agiria na pasta errada.
PHPORTO_WSL_ROOT=/home/usuario/projetos

# Distro passada ao wsl.exe -d. Precisa aparecer em "wsl -l -q".
PHPORTO_DISTRO=Debian

# Segundos até o processo ser morto.
#
# NÃO USE VALOR BAIXO. Acordar a VM do WSL custa cerca de 4,5 s (medido:
# 4543 ms com a VM fria, 88 ms depois), e ela dorme sozinha. Com 3 ou 5
# segundos, o PRIMEIRO comando de cada dia falha SEMPRE — e o erro parece do
# comando, não da configuração. O piso aplicado pelo código é 30 s.
PHPORTO_TIMEOUT=120

# Fuso usado na data dos registros.
PHPORTO_TZ=America/Sao_Paulo

# ===========================================================================
# WINDOWS
# ===========================================================================

# NÃO HÁ NADA A CONFIGURAR AQUI ALÉM DO TIMEOUT.
#
# As treze ações do Windows moram neste repositório, em src/Win/actions, e quem
# monta o ambiente delas é o src/Win/bootstrap.ps1. Não existe caminho externo a
# apontar: até a migração havia um PHPORTO_WINUTIL_PATH obrigatório, que
# amarrava a tela /win a um projeto separado na máquina de quem clonava.
#
# As ações pedem Administrador, e é por isso que a /config abre um PowerShell
# ELEVADO. Esse estado é de vida curta: reiniciar o servidor volta a desligado,
# porque o marcador é amarrado ao PID do php -S.

# Segundos até uma ação do Windows ser cancelada.
#
# A chave mantém WINUTIL no nome. É herança, e ficou de propósito: renomear
# obrigaria quem já tem um .env a editá-lo para não perder o valor, e o ganho
# seria só cosmético.
#
# NÃO USE VALOR BAIXO. Aqui as ações longas são a regra: audit gera oito
# blocos de log, network captura pelo tempo pedido e ainda monta o relatório,
# install chama o winget (que baixa) e debloat percorre 22 pacotes APPX. Uma
# instalação morta no meio deixa o sistema num estado que a ferramenta não
# sabe descrever. O piso aplicado pelo código é 60 s.
#
# A espera é SÍNCRONA: a aba fica parada até a ação terminar, e é isso que
# garante que o registro chega ao banco. E como o php -S é um processo só
# atendendo em série, uma ação longa congela as outras telas enquanto roda.
PHPORTO_WINUTIL_TIMEOUT=600

# ===========================================================================
# SUPERFÍCIES
# ===========================================================================

# As telas /, /config e /wsl. Desligada, as três respondem 404.
PHPORTO_DASHBOARD_ENABLED=true

# A API JSON em /api/executions (GET lista, POST executa).
# NASCE DESLIGADA de propósito: quem clona não deve ganhar uma superfície de
# execução por HTTP sem ter pedido. Desligada, responde 404 — não 403, que
# confirmaria que existe algo ali.
PHPORTO_API_ENABLED=false

# Origem aceita pela API. Só vale para /api/*; as telas são mesma origem.
CORS_ORIGIN=http://127.0.0.1:4001

# ===========================================================================
# BANCO — onde os registros de execução ficam
# ===========================================================================

# Provider padrão: sqlite (zero infraestrutura externa — banco em arquivo
# local). Alternativas para banco gerenciado já existente: mysql, mongo.
DB_PROVIDER=sqlite

# SQLITE (padrão)
# Caminho do arquivo .sqlite. Relativo é ancorado na raiz do projeto; absoluto
# vale com as duas barras (C:\dados\x.sqlite ou C:/dados/x.sqlite). A pasta tem
# de existir — o arquivo nasce sozinho, a pasta não.
SQLITE_PATH=storage/database.sqlite
SQLITE_TABLE=executions

# MONGO
MONGODB_URI="mongodb+srv://USUARIO:SENHA@CLUSTER.exemplo.mongodb.net/NOME_DO_BANCO?appName=APP_NAME"
MONGO_DB_NAME=nome_do_banco
MONGO_COLLECTION=executions

# MYSQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nome_do_banco
MYSQL_USER=usuario
MYSQL_PASSWORD=senha
MYSQL_TABLE=executions

# ===========================================================================
# MYSQL — TESTES DE INTEGRAÇÃO (opcional)
#
# Sem estas variáveis, tests/Integration/MySQLProviderTest.php é PULADO e a
# suíte segue verde. Preencha só quando quiser exercitar o MySQLProvider
# contra um MySQL de verdade. Os testes usam uma tabela isolada, criada e
# dropada por eles — nunca a MYSQL_TABLE acima.
#
# ATENÇÃO: a suíte NÃO lê este arquivo. O bootstrap do PHPUnit é o autoload do
# Composer, não o bootstrap.php, então o phpdotenv não roda nos testes.
# Exporte as variáveis no ambiente:
#   $env:MYSQL_TEST_DATABASE="..."; $env:MYSQL_TEST_USER="..."
# ===========================================================================
MYSQL_TEST_HOST=127.0.0.1
MYSQL_TEST_PORT=3306
MYSQL_TEST_DATABASE=nome_do_banco_de_teste
MYSQL_TEST_USER=usuario_de_teste
MYSQL_TEST_PASSWORD=senha_de_teste
