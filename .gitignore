# Dependências instaladas pelo Composer. O composer.lock É versionado —
# isto é aplicação (type: project), não biblioteca: o lock garante que
# outra máquina instale exatamente as mesmas versões.
/vendor/

# Configuração local com credenciais e caminhos da máquina de quem usa.
# O .env.example é o versionado.
/.env

# O banco: contém TUDO que foi executado nesta máquina — comandos, saídas e
# caminhos reais, em texto puro. Nunca entra no repositório.
/storage/*.sqlite

# O que a tela de configuração alternou nesta máquina. É estado local, não
# projeto: quem clona deve receber os padrões do .env.example, com a API
# desligada, e não a decisão que alguém tomou em outro computador.
/storage/flags.json

# O marcador do PowerShell elevado. É o estado mais local que existe aqui: dois
# PIDs de processos desta execução desta máquina. Versionar não seria só ruído
# — quem clonasse receberia um marcador apontando para PIDs que na máquina dele
# são de outros programas.
/storage/win-elevation.json

# O contador de tentativas erradas do token. Estado desta máquina, como o
# marcador acima.
/storage/auth-falhas.json

# Pasta de trabalho do motor: o cmd.sh descartável guarda o último comando
# executado, e os .tmp guardam a saída.
/files/*
!/files/.gitkeep

# Caches das ferramentas.
/.phpstan-cache/
/.php-cs-fixer.cache

# Estado local do Claude Code: as skills em .claude/skills/ SÃO versionadas
# (são documentação do projeto), o estado de máquina não.
/.claude/settings.local.json

# Binário da ação `memory`, baixado na primeira execução (482 KB). O
# winutil-cli já o mantinha fora do repositório; a decisão não é nova, só não
# foi desfeita. Ver src/Win/THIRD-PARTY.md.
/src/Win/tools/WinMemoryCleaner.exe

# Relatório JUnit que o `Invoke-Pester -CI` escreve. O -CI está lá pelo código
# de saída (sem ele, teste falhando não derruba o `composer gate`); o XML é
# subproduto.
/testResults.xml
