# Dependências instaladas pelo Composer. O composer.lock É versionado —
# isto é aplicação (type: project), não biblioteca: o lock garante que
# outra máquina instale exatamente as mesmas versões.
/vendor/

# Configuração local com credenciais e caminhos da máquina de quem usa.
# O .env.example é o versionado.
/.env

# O banco: contém TUDO que foi executado nesta máquina — comandos, saídas e
# caminhos reais, em texto puro. Nunca entra no repositório.
/storage/*.sqlite

# Pasta de trabalho do motor: o cmd.sh descartável guarda o último comando
# executado, e os .tmp guardam a saída.
/files/*
!/files/.gitkeep

# Caches das ferramentas.
/.phpstan-cache/
/.php-cs-fixer.cache

# Estado local do Claude Code: as skills em .claude/skills/ SÃO versionadas
# (são documentação do projeto), o estado de máquina não.
/.claude/settings.local.json
